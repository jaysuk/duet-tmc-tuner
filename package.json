    "@vue/test-utils": "^2.5.1",
    "dwc-plugin-test-kit": "^0.2.10",
    "happy-dom": "^21.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vuetify": "^4.2.6"
  }
